import { ScrollView } from "std-widgets.slint";
import { Palette, Typography, Spacing } from "theme.slint";
import { AGButton, AGButtonVariant, AGCard, AGElevation, AGTag, AGTagVariant, AGHr } from "components.slint";

export struct ToolCheckRow {
    name: string,
    status: string,
    ok: bool,
}

// Phase 7 §7.8.6: new GUI surface over the already-existing `doctor`
// diagnostics (Phase 6 §6.9), which `engine::run_doctor` used to only
// `println!` directly — `engine::collect_doctor_report` now returns the
// same checks as structured data this dialog binds to, no duplicated logic.
export component DoctorDialog inherits Window {
    title: "AutoGSE - Doctor";
    preferred-width: 720px;
    preferred-height: 680px;
    background: Palette.bg;

    in property <bool> dpapi_ok: false;
    in property <string> dpapi_detail: "";
    in property <string> known_target_summary: "";
    in property <string> version_summary: "";
    in property <[ToolCheckRow]> tool_checks: [];
    in property <[string]> log_lines: [];

    callback refresh_requested();

    VerticalLayout {
        padding: Spacing.space-3;
        spacing: Spacing.space-2;

        HorizontalLayout {
            spacing: Spacing.space-3;
            AGCard {
                elevation: AGElevation.sm;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Spacing.space-2;
                    spacing: Spacing.space-1;
                    Text {
                        text: "DPAPI SELF-TEST";
                        font-size: Typography.meta;
                        color: Palette.accent-700;
                    }
                    Text {
                        text: dpapi_ok ? "Pass" : "Fail";
                        font-weight: Typography.heading-weight;
                        font-size: Typography.h6;
                        color: Palette.text;
                    }
                }
            }
            AGCard {
                elevation: AGElevation.sm;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Spacing.space-2;
                    spacing: Spacing.space-1;
                    Text {
                        text: "TRACKED GAMES";
                        font-size: Typography.meta;
                        color: Palette.accent-700;
                    }
                    Text {
                        text: known_target_summary;
                        font-weight: Typography.heading-weight;
                        font-size: Typography.h6;
                        color: Palette.text;
                    }
                }
            }
            AGCard {
                elevation: AGElevation.sm;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Spacing.space-2;
                    spacing: Spacing.space-1;
                    Text {
                        text: "VERSION";
                        font-size: Typography.meta;
                        color: Palette.accent-700;
                    }
                    Text {
                        text: version_summary;
                        font-weight: Typography.heading-weight;
                        font-size: Typography.h6;
                        color: Palette.text;
                    }
                }
            }
        }

        AGHr { }

        Text {
            text: "Bundled tool";
            font-weight: Typography.heading-weight;
            color: Palette.text;
        }
        for tc in tool_checks: HorizontalLayout {
            padding-top: Spacing.space-1;
            padding-bottom: Spacing.space-1;
            Text {
                horizontal-stretch: 1;
                text: tc.name;
                color: Palette.text;
                vertical-alignment: center;
            }
            AGTag {
                text: tc.status;
                variant: tc.ok ? AGTagVariant.accent : AGTagVariant.outline;
            }
        }

        AGHr { }

        Text {
            text: "Live log";
            font-weight: Typography.heading-weight;
            color: Palette.text;
        }
        Rectangle {
            vertical-stretch: 1;
            background: Palette.neutral-900;
            ScrollView {
                VerticalLayout {
                    padding: Spacing.space-2;
                    alignment: start;
                    for line in log_lines: Text {
                        text: line;
                        color: Palette.neutral-100;
                        font-size: Typography.meta;
                        wrap: word-wrap;
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            AGButton {
                text: "Refresh";
                clicked => { refresh_requested(); }
            }
        }
    }
}
