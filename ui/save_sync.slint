import { LineEdit, ScrollView } from "std-widgets.slint";
import { Palette, Typography, Spacing } from "theme.slint";
import { AGButton, AGButtonVariant, AGCard, AGElevation, AGTag, AGTagVariant, AGHr, AGTableHeaderRow, AGTableRow } from "components.slint";

export struct BackupSnapshotRow {
    id: string,
    achievements: string,
    save_size: string,
}

// Phase 8 §8.2/§8.5/Phase 7 §7.8.9 (deferred there, now buildable): a
// per-target dialog showing the resolved Steam-side and Goldberg-side save
// locations (migrate either direction, backing up the destination first —
// `save_sync::migrate`) and this target's local backup snapshots (create/
// restore — `backup_manager`). "Cloud" is scoped to any local folder path
// (§8.5's corrected scope) — no cloud API/OAuth integration exists.
export component SaveSyncDialog inherits Window {
    title: "AutoGSE - Save & Cloud Sync Manager";
    preferred-width: 720px;
    preferred-height: 680px;
    background: Palette.bg;

    in property <string> target_path: "";
    in property <string> steam_path: "";
    in property <string> goldberg_path: "";
    in property <[BackupSnapshotRow]> backups: [];
    in-out property <string> cloud_target: "";
    in property <string> status_message: "";
    in property <bool> busy: false;

    callback migrate_to_goldberg_requested();
    callback migrate_to_steam_requested();
    callback backup_now_requested();
    callback restore_requested(string /* snapshot id */);
    callback sync_now_requested(string /* cloud folder */);

    VerticalLayout {
        padding: Spacing.space-3;
        spacing: Spacing.space-2;

        Text {
            text: "Save & Cloud Sync — " + target_path;
            font-weight: Typography.heading-weight;
            font-size: Typography.h5;
            color: Palette.text;
            wrap: word-wrap;
        }

        AGTableHeaderRow {
            Text { horizontal-stretch: 1; text: "SOURCE"; font-size: Typography.meta; color: Palette.neutral-600; }
            Text { width: 260px; text: "PATH"; font-size: Typography.meta; color: Palette.neutral-600; }
            Text { width: 140px; text: "TYPE"; font-size: Typography.meta; color: Palette.neutral-600; }
            Text { width: 160px; text: ""; }
        }
        AGTableRow {
            Text { horizontal-stretch: 1; text: "Steam"; color: Palette.text; vertical-alignment: center; }
            Text { width: 260px; text: steam_path; font-size: Typography.meta; color: Palette.neutral-700; wrap: word-wrap; vertical-alignment: center; }
            AGTag { width: 90px; text: "Native"; variant: AGTagVariant.neutral; }
            AGButton {
                text: "Migrate to Goldberg";
                enabled: !busy;
                clicked => { migrate_to_goldberg_requested(); }
            }
        }
        AGTableRow {
            Text { horizontal-stretch: 1; text: "Goldberg"; color: Palette.text; vertical-alignment: center; }
            Text { width: 260px; text: goldberg_path; font-size: Typography.meta; color: Palette.neutral-700; wrap: word-wrap; vertical-alignment: center; }
            AGTag { width: 90px; text: "Active"; variant: AGTagVariant.accent; }
            AGButton {
                text: "Migrate to Steam";
                enabled: !busy;
                clicked => { migrate_to_steam_requested(); }
            }
        }

        AGHr { }

        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: "Backups";
                font-weight: Typography.heading-weight;
                font-size: Typography.label;
                color: Palette.text;
                vertical-alignment: center;
            }
            AGButton {
                text: busy ? "Working..." : "Backup Now";
                variant: AGButtonVariant.primary;
                enabled: !busy;
                clicked => { backup_now_requested(); }
            }
        }

        ScrollView {
            VerticalLayout {
                AGTableHeaderRow {
                    Text { horizontal-stretch: 1; text: "SNAPSHOT"; font-size: Typography.meta; color: Palette.neutral-600; }
                    Text { width: 120px; text: "ACHIEVEMENTS"; font-size: Typography.meta; color: Palette.neutral-600; }
                    Text { width: 100px; text: "SAVE"; font-size: Typography.meta; color: Palette.neutral-600; }
                    Text { width: 100px; text: ""; }
                }
                for b in backups: AGTableRow {
                    Text { horizontal-stretch: 1; text: b.id; font-size: Typography.meta; color: Palette.text; vertical-alignment: center; }
                    Text { width: 120px; text: b.achievements; font-size: Typography.meta; color: Palette.text; vertical-alignment: center; }
                    Text { width: 100px; text: b.save_size; font-size: Typography.meta; color: Palette.text; vertical-alignment: center; }
                    AGButton {
                        text: "Restore";
                        enabled: !busy;
                        clicked => { restore_requested(b.id); }
                    }
                }
            }
        }

        AGHr { }

        HorizontalLayout {
            spacing: Spacing.space-2;
            AGCard {
                elevation: AGElevation.none;
                horizontal-stretch: 1;
                VerticalLayout {
                    Text { text: "Cloud target (any local folder — e.g. an OneDrive/Google Drive/Dropbox sync folder)"; font-size: Typography.meta; color: Palette.neutral-700; wrap: word-wrap; }
                    Rectangle {
                        background: white;
                        border-width: 2px;
                        border-color: Palette.text;
                        height: 36px;
                        HorizontalLayout {
                            padding-left: Spacing.space-2;
                            cloud_input := LineEdit {
                                placeholder-text: "C:\\Users\\you\\OneDrive\\AutoGSE\\backups";
                                text <=> cloud_target;
                            }
                        }
                    }
                }
            }
            AGButton {
                text: "Sync Now";
                variant: AGButtonVariant.primary;
                enabled: !busy;
                clicked => { sync_now_requested(cloud_input.text); }
            }
        }

        Text {
            text: status_message;
            color: Palette.text;
            wrap: word-wrap;
            font-size: Typography.meta;
        }
    }
}
