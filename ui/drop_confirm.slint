import { Palette, Typography, Spacing } from "theme.slint";
import { AGButton, AGButtonVariant, AGCard, AGElevation, AGTag, AGTagVariant } from "components.slint";
import { IconDownload } from "icons.slint";

// Phase 7 §7.8.2: a dedicated confirm view for a real native file drop
// (§7.3), opened by `autogse_gui.rs`'s drop-target callback instead of
// silently just filling the dashboard's App ID text field as before.
//
// **Correction found while building this**: the "files to back up / files
// to inject" list below doesn't need Phase 12 §12.1's not-yet-built
// `--dry-run` the way this section's first roadmap draft assumed — for
// `regular`-mode injection those three lines are always the same
// (`steam_api(64).dll` backup + Goldberg DLL + `steam_settings/`), so this
// is real, accurate static text, not a guess. Only "Confirm Injection"
// actually performing a real inject is genuinely blocked (§7.0's Steam
// Guard relay item) — that button stays disabled with a tooltip.
export component DropConfirmDialog inherits Window {
    title: "AutoGSE - Drag-and-Drop Injection";
    preferred-width: 640px;
    preferred-height: 520px;
    background: Palette.bg;

    in property <string> status_message: "Resolving...";
    in property <bool> resolved: false;
    in property <string> detected_title: "";
    in property <string> detected_path: "";
    in property <string> detected_arch: "";
    in property <string> detected_appid: "";

    callback cancelled();

    VerticalLayout {
        padding: Spacing.space-3;
        spacing: Spacing.space-3;

        Rectangle {
            vertical-stretch: 1;
            border-width: 3px;
            border-color: Palette.accent;
            background: Palette.accent-100;
            VerticalLayout {
                alignment: center;
                spacing: Spacing.space-2;
                IconDownload {
                    width: 40px;
                    height: 40px;
                    stroke: Palette.accent;
                    x: (parent.width - self.width) / 2;
                }
                Text {
                    text: status_message;
                    font-weight: Typography.heading-weight;
                    font-size: Typography.h5;
                    color: Palette.accent-700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if resolved: AGCard {
            elevation: AGElevation.md;
            HorizontalLayout {
                padding: Spacing.space-2;
                spacing: Spacing.space-4;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Spacing.space-1;
                    Text {
                        text: "DETECTED";
                        font-size: Typography.meta;
                        color: Palette.accent-700;
                    }
                    Text {
                        text: detected_title;
                        font-weight: Typography.heading-weight;
                        font-size: Typography.label;
                        color: Palette.text;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Spacing.space-1;
                        AGTag { text: detected_arch; variant: AGTagVariant.neutral; }
                        AGTag { text: "App ID " + detected_appid; variant: AGTagVariant.accent; }
                    }
                    Text {
                        text: detected_path;
                        font-size: Typography.meta;
                        color: Palette.neutral-700;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Spacing.space-1;
                    Text {
                        text: "FILES TO BACK UP";
                        font-size: Typography.meta;
                        color: Palette.accent-700;
                    }
                    Text {
                        text: "steam_api64.dll → steam_api64.dll.org";
                        font-size: Typography.meta;
                        color: Palette.text;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "FILES TO INJECT";
                        font-size: Typography.meta;
                        color: Palette.accent-700;
                    }
                    Text {
                        text: "steam_api64.dll (Goldberg)";
                        font-size: Typography.meta;
                        color: Palette.text;
                    }
                    Text {
                        text: "steam_settings/";
                        font-size: Typography.meta;
                        color: Palette.text;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Spacing.space-2;
            alignment: end;
            AGButton {
                text: "Cancel";
                clicked => { cancelled(); }
            }
            AGButton {
                text: "Confirm Injection";
                variant: AGButtonVariant.primary;
                enabled: false;
            }
        }
    }
}
