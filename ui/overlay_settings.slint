import { LineEdit, ComboBox } from "std-widgets.slint";
import { Palette, Typography, Spacing } from "theme.slint";
import { AGButton, AGButtonVariant, AGCard, AGElevation, AGField } from "components.slint";

// Phase 7 §7.8.6: new GUI surface wired entirely to already-complete backend
// (`preferences::OverlayPrefs`/`set_overlay_prefs`, the same 8 keys the
// `configure-overlay` CLI subcommand already writes, §6.3) — no new engine
// logic, pure GUI wiring. Global, not per-game: `OverlayPrefs` is one
// preference on the whole-machine `Preferences` struct, applied to every
// future `inject --overlay` run, so (unlike the achievement/config-editor
// dialogs) this dialog needs no target path at all.
//
// **Correction found while building this**: the mockup shows "Enable
// experimental overlay" and "Deploy default fonts & sounds" as On/Off
// toggles, but neither has a persisted backing value in this codebase —
// enabling the overlay is the CLI's per-run `--overlay` flag (there's no
// inject-from-GUI yet to attach a toggle to, §7.0's still-open blocker),
// and font/sound deployment already happens unconditionally whenever
// `--overlay` is passed (`goldberg::deploy_overlay_assets`), with no
// separate on/off preference to control independently. Rather than wire a
// toggle to nothing, this dialog only exposes the warning text (informational)
// and the 8 real, saveable notification-tuning fields.
export component OverlaySettingsDialog inherits Window {
    title: "AutoGSE - Overlay Settings";
    preferred-width: 560px;
    preferred-height: 520px;
    background: Palette.bg;

    in property <string> pos_achievement: "";
    in property <string> pos_invitation: "";
    in property <string> pos_chat_msg: "";
    in property <string> duration_progress: "";
    in property <string> duration_achievement: "";
    in property <string> duration_invitation: "";
    in property <string> duration_chat: "";
    in property <string> notification_animation: "";
    in property <string> status_message: "";

    callback save_requested(string /* pos_achievement */, string /* pos_invitation */, string /* pos_chat_msg */,
        string /* duration_progress */, string /* duration_achievement */, string /* duration_invitation */,
        string /* duration_chat */, string /* notification_animation */);

    VerticalLayout {
        padding: Spacing.space-3;
        spacing: Spacing.space-2;

        Text {
            text: "Overlay Settings";
            font-weight: Typography.heading-weight;
            font-size: Typography.h4;
            color: Palette.text;
        }

        AGCard {
            elevation: AGElevation.none;
            background: Palette.accent-100;
            VerticalLayout {
                padding: Spacing.space-2;
                Text {
                    text: "Experimental — the vendored tool's own docs warn enabling the overlay \"might cause crashes or other problems,\" surfaced every time `--overlay` is passed on inject, whether interactive or `--silent`.";
                    color: Palette.accent-800;
                    font-size: Typography.meta;
                    wrap: word-wrap;
                }
            }
        }

        Text {
            text: "Fields below are saved as your notification-tuning preference and applied on every future `inject --overlay` run (same as `autogse configure-overlay`). Leave a field blank to leave that key unchanged.";
            font-size: Typography.meta;
            color: Palette.neutral-700;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Spacing.space-3;
            AGField {
                label: "Achievement position";
                pos_achievement_combo := ComboBox {
                    model: ["", "top_left", "top_center", "top_right", "bot_left", "bot_center", "bot_right"];
                    current-value: pos_achievement;
                }
            }
            AGField {
                label: "Invitation position";
                pos_invitation_combo := ComboBox {
                    model: ["", "top_left", "top_center", "top_right", "bot_left", "bot_center", "bot_right"];
                    current-value: pos_invitation;
                }
            }
            AGField {
                label: "Chat position";
                pos_chat_combo := ComboBox {
                    model: ["", "top_left", "top_center", "top_right", "bot_left", "bot_center", "bot_right"];
                    current-value: pos_chat_msg;
                }
            }
        }

        HorizontalLayout {
            spacing: Spacing.space-3;
            AGField {
                label: "Progress duration (s)";
                dur_progress_input := LineEdit { text: duration_progress; }
            }
            AGField {
                label: "Achievement duration (s)";
                dur_achievement_input := LineEdit { text: duration_achievement; }
            }
        }
        HorizontalLayout {
            spacing: Spacing.space-3;
            AGField {
                label: "Invitation duration (s)";
                dur_invitation_input := LineEdit { text: duration_invitation; }
            }
            AGField {
                label: "Chat duration (s)";
                dur_chat_input := LineEdit { text: duration_chat; }
            }
        }
        AGField {
            label: "Animation duration (s, 0 disables)";
            animation_input := LineEdit { text: notification_animation; }
        }

        HorizontalLayout {
            alignment: end;
            AGButton {
                text: "Save";
                variant: AGButtonVariant.primary;
                clicked => {
                    save_requested(
                        pos_achievement_combo.current-value,
                        pos_invitation_combo.current-value,
                        pos_chat_combo.current-value,
                        dur_progress_input.text,
                        dur_achievement_input.text,
                        dur_invitation_input.text,
                        dur_chat_input.text,
                        animation_input.text,
                    );
                }
            }
        }

        Text {
            text: status_message;
            color: Palette.text;
            wrap: word-wrap;
            font-size: Typography.meta;
        }
    }
}
