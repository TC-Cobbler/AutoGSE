// Phase 7 §7.8.0: design tokens transcribed verbatim from
// `Mockups/modernist-design-tokens.md` — flat, architectural Swiss-modernist:
// near-mono red on off-white, zero corner radius, strong 2px rules. Every
// other `ui/*.slint` file should reference these globals instead of
// hand-rolling its own inline colors (the pre-§7.8 convention every existing
// file used, with no shared source).
//
// Font note: the token doc specifies "Archivo" (weight 400 body / 800
// heading), a Google Font not preinstalled on Windows and not vendored in
// this repo yet — `Typography.heading-weight`/`body-weight` below are used
// with the platform default sans-serif font as an honest fallback. Swap in
// real `Archivo-Regular.ttf`/`Archivo-ExtraBold.ttf` via `slint-build`'s font
// embedding once those files are supplied; do not silently claim Archivo is
// in use before then.

export global Palette {
    out property <color> bg: #f3f2f2;
    out property <color> surface: #eae9e9;
    out property <color> text: #201e1d;
    out property <color> accent: #ec3013;
    out property <color> accent-2: #e15b47;
    // `color-mix(in srgb, #201e1d 40%, transparent)` has no direct Slint
    // equivalent (no color-mix function) — approximated as an 8-digit hex
    // color with a 40% alpha channel (`66` = 102/255 ≈ 0.4) instead.
    out property <color> divider: #201e1d66;

    // Neutral ramp 100-900.
    out property <color> neutral-100: #f8f4f4;
    out property <color> neutral-200: #eae7e7;
    out property <color> neutral-300: #d7d3d3;
    out property <color> neutral-400: #bab6b6;
    out property <color> neutral-500: #9b9797;
    out property <color> neutral-600: #7d7979;
    out property <color> neutral-700: #605d5d;
    out property <color> neutral-800: #444141;
    out property <color> neutral-900: #2d2b2b;

    // Accent ramp 100-900.
    out property <color> accent-100: #fff2ef;
    out property <color> accent-200: #ffe0d9;
    out property <color> accent-300: #ffc4b8;
    out property <color> accent-400: #ff9783;
    out property <color> accent-500: #ff563c;
    out property <color> accent-600: #dd2b0f;
    out property <color> accent-700: #ae1800;
    out property <color> accent-800: #7c1405;
    out property <color> accent-900: #4d170e;

    // Accent-2 ramp 100-900.
    out property <color> accent2-100: #fff2ef;
    out property <color> accent2-200: #ffe0da;
    out property <color> accent2-300: #ffc4b9;
    out property <color> accent2-400: #ff9784;
    out property <color> accent2-500: #ef6853;
    out property <color> accent2-600: #c94b39;
    out property <color> accent2-700: #9e3526;
    out property <color> accent2-800: #71261b;
    out property <color> accent2-900: #471d16;

    // Ink-tinted shadow tints (used as `drop-shadow-color` alongside the
    // per-elevation blur/offset constants in `components.slint`'s `Card`).
    out property <color> shadow-tint: #2d2b2b;
}

export global Typography {
    out property <int> heading-weight: 800;
    out property <int> body-weight: 400;

    out property <length> h1: 42px;
    out property <length> h2: 32px;
    out property <length> h3: 25px;
    out property <length> h4: 20px;
    out property <length> h5: 16px;
    out property <length> h6: 13px;
    out property <length> body: 15px;
    // Component text (tags/labels/meta/table cells): 11-14px in the token
    // doc's range — `meta` sits at the small end, `label` at the large end.
    out property <length> meta: 11px;
    out property <length> label: 13px;
}

export global Spacing {
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
}
