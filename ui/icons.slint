import { Palette } from "theme.slint";

// Phase 7 §7.8.0: icon glyphs, converted directly from the real inline SVGs
// already present in `Mockups/App Mockups.dc.html` (a Lucide-style stroke
// icon set per `modernist-design-tokens.md`) — not re-guessed or refetched
// from a third party, so these are pixel-faithful to what the mockup itself
// renders. Every `Path.commands` string below is the mockup's own SVG `d`
// attribute copied verbatim (Slint's path mini-language follows standard SVG
// path syntax, including lowercase relative commands, so no
// relative-to-absolute conversion is needed or attempted here — doing that
// by hand would risk introducing exactly the kind of silent numeric error
// this project's own conventions avoid). Circles (Lucide's `<circle>`
// elements have no Slint `Path` equivalent) become bordered `Rectangle`s
// with `border-radius: self.width / 2`; `<polyline>`/`<line>` become
// straight-line `M`/`L` command strings (a mechanical, not lossy, conversion).
//
// All icons share a 24x24 source viewbox (Lucide's native grid) scaled to
// whatever `width`/`height` the instance sets (16px default, matching the
// mockup's `.icon` class).

component IconBase inherits Rectangle {
    in property <color> stroke: Palette.text;
    width: 16px;
    height: 16px;
    background: transparent;
}

// Dashboard "Scan" button — refresh/reload arrows.
export component IconRefresh inherits IconBase {
    Path {
        commands: "M23 4 L23 10 L17 10";
        stroke: root.stroke;
        stroke-width: 2px;
        viewbox-width: 24;
        viewbox-height: 24;
    }
    Path {
        commands: "M20.49 15a9 9 0 1 1-2.12-9.36L23 10";
        stroke: root.stroke;
        stroke-width: 2px;
        viewbox-width: 24;
        viewbox-height: 24;
    }
}

// Dashboard filter field — magnifying glass.
export component IconSearch inherits IconBase {
    Rectangle {
        x: 3px / 24px * root.width;
        y: 3px / 24px * root.width;
        width: 16px / 24px * root.width;
        height: 16px / 24px * root.width;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: root.stroke;
        background: transparent;
    }
    Path {
        commands: "M21 21 L16.65 16.65";
        stroke: root.stroke;
        stroke-width: 2px;
        viewbox-width: 24;
        viewbox-height: 24;
    }
}

